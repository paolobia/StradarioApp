<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StradarioApp</AssemblyName>
    <RootNamespace>StradarioApp</RootNamespace>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Avalonia per portabilità Linux/Windows -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Icona dell'eseguibile Windows (mostrata in Explorer/taskbar); su Linux
         questo attributo del PE viene semplicemente ignorato dal toolchain. -->
    <ApplicationIcon>Resources/AppIcon/StradarioApp.ico</ApplicationIcon>
    <!-- Versione corrente: mostrata nel dialog "Info su" e confrontata con
         l'ultimo tag delle GitHub Release da Services/UpdateChecker per
         segnalare aggiornamenti disponibili. Va allineata manualmente al tag
         creato per ogni release (vedi CLAUDE.md). -->
    <Version>1.4.0</Version>
    <!-- osm/ è un progetto .NET separato (OsmExtractor, vedi osm/CLAUDE.md):
         senza questa esclusione il glob di default dell'SDK inglobava anche
         i suoi .cs (compreso il GlobalUsings.g.cs generato nel suo obj/,
         che con ImplicitUsings porta un "global using System.IO" e va in
         conflitto con Avalonia.Controls.Shapes.Path in UI/DialogUi.cs). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);osm/**;webapp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI cross-platform Linux/Windows: versioni allineate 11.2.x -->
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />

    <!-- SkiaSharp per disegnare sulla mappa.
         NON esiste "SkiaSharp.Views.Avalonia": il canvas custom
         si implementa sovrascrivendo Render() su un Control Avalonia,
         passando il DrawingContext a SkiaSharp via ISkiaDrawingContextImpl. -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.0" />

    <!-- Tile OSM: schema URL e TileIndex -->
    <PackageReference Include="BruTile" Version="4.0.0" />

    <!-- Generazione PDF -->
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />

    <!-- Serializzazione progetto JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Parser Markdown (CommonMark) per le descrizioni di POI/percorsi/pagine,
         renderizzate ricche nel PDF (Services/MarkdownPdfRenderer.cs) e in
         forma semplificata nei tooltip mappa (Services/MarkdownPlainText.cs).
         Unica eccezione voluta alla convenzione "zero dipendenze extra"
         seguita altrove (KML/GPX/CSV fatti a mano): un parser CommonMark
         completo scritto a mano sarebbe enorme e fragile, Markdig è lo
         standard di fatto in .NET, maturo e MIT. -->
    <PackageReference Include="Markdig" Version="0.37.0" />

    <!-- Implementazione TLS interamente gestita (C# puro, nessuna dipendenza
         nativa), usata SOLO da Services/BouncyCastleHttpClient.cs come
         ultimo tentativo dell'instradamento OSRM quando lo stack TLS di
         Windows (SChannel) è così datato/rotto da non avere alcuna suite
         cifrata in comune col server (visto in un caso reale: SChannel
         senza supporto GCM affatto) — bypassa del tutto SChannel, come fa
         un browser con la propria libreria TLS. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icona applicativa (finestra/taskbar a runtime), caricata via
         Assembly.GetManifestResourceStream in App.OnFrameworkInitializationCompleted. -->
    <EmbeddedResource Include="Resources/AppIcon/icon-256.png">
      <LogicalName>StradarioApp.AppIcon.png</LogicalName>
    </EmbeddedResource>

    <!-- Confini nazionali + coste (Natural Earth 1:110m "admin 0 countries",
         dominio pubblico), usati per la mini-mappa schematica nella pagina
         indice del PDF (Services/WorldBordersService.cs). Formato JSON
         minimizzato ad-hoc (non il GeoJSON originale), gzippato: ~65 KB,
         nessuna dipendenza di rete a runtime, a differenza di cities500.csv
         che è troppo grande per essere bundlato. -->
    <EmbeddedResource Include="Resources/WorldBorders/world_borders.geojson.gz">
      <LogicalName>StradarioApp.WorldBorders.geojson.gz</LogicalName>
    </EmbeddedResource>

    <!-- Laghi principali + fiumi principali (Natural Earth 1:110m
         "lakes"/"rivers_lake_centerlines", dominio pubblico), stesso
         standard/precisione dei confini sopra, usati dalla mini-mappa
         schematica per dare un riferimento geografico oltre al solo
         contorno di terra (Services/WaterFeaturesService.cs). ~11 KB
         gzippato: solo i laghi/fiumi rilevanti a scala globale (24 laghi,
         13 fiumi), non un dataset idrografico completo. -->
    <EmbeddedResource Include="Resources/WorldBorders/water_features.geojson.gz">
      <LogicalName>StradarioApp.WorldBorders.water.geojson.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
